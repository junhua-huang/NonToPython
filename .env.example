# NanTuPy Baota Docker deployment environment template
# Copy this file to .env on the server and fill real values there.
# Do not commit or upload your real .env to public places.

# Runtime
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
HIDE_API_DOCS=0
PERF_SLOW_REQUEST_MS=500

# App update releases are stored in the app_releases database table.
# Apply Alembic migrations before serving /api/app/version. Download URLs
# entered through the admin API must use HTTPS; no signing secret is needed.

# Deployment control plane (disabled until an operator configures the worker).
# IDs are database users.id values; users must also have the live admin role.
DEPLOYMENT_ENABLED=false
DEPLOYMENT_OPERATOR_IDS=
DEPLOYMENT_ARTIFACT_DIR=/var/lib/nonto/deployment-artifacts
DEPLOYMENT_SITE_DIR=/www/wwwroot/nonto.online
DEPLOYMENT_MAX_BYTES=536870912
DEPLOYMENT_MAX_EXPANDED_BYTES=2147483648
DEPLOYMENT_MAX_FILES=20000

# Security
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# CORS
# Comma-separated HTTPS origins. Example: https://www.nonto.online,https://nonto.online
CORS_ORIGINS=https://www.nonto.online

# MySQL
# For Baota MySQL on the Docker host, keep DB_HOST=host.docker.internal.
# docker-compose.yml maps host.docker.internal to the Linux host gateway.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=nantupy
DB_PASS=replace-with-database-password
DB_NAME=facebook

# Tencent COS / object storage
COS_ID=
COS_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_BUCKET_NAME=
COS_DOMAIN=
COS_CI_IMAGE_AUDIT_ENABLED=false
COS_CI_IMAGE_AUDIT_BIZ_TYPE=
COS_CI_IMAGE_AUDIT_TIMEOUT_SECONDS=8
COS_CI_IMAGE_AUDIT_LARGE_IMAGE_DETECT=0

# SMTP email verification
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true

# Aliyun Mobile Push server credentials
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_PUSH_APP_KEY_ANDROID=
ALIYUN_PUSH_ENDPOINT=https://cloudpush.aliyuncs.com
ALIYUN_PUSH_REGION_ID=cn-hangzhou
ALIYUN_PUSH_ANDROID_ACTIVITY=com.nonto.nonto.MainActivity
ALIYUN_PUSH_ANDROID_CHANNEL_ID=nonto_message_alerts
